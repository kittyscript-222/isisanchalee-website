{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/testimonial-upload.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/email-scheduler",
      "schedule": "0 9 * * *"
    }
  ]
}
